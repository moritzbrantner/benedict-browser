{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>brave/renovate-config",
    "github>moritzbrantner/coding-agent-conventions"
  ],
  "addLabels": [
    "CI/skip",
    "dependencies",
    "renovate"
  ],
  "draftPR": false,
  "ignorePaths": [
    "components/**",
    "ios/**",
    "test/**",
    "third_party/**",
    "tools/crates/vendor/**",
    "third_party/wasm/**"
  ],
  "platformAutomerge": true
}
